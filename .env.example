# Neon Postgres connection string (from the Neon dashboard)
DATABASE_URL=

# GHL Private Integration Token
# Generate in the RG GHL account: Settings -> Private Integrations
GHL_PRIVATE_INTEGRATION_TOKEN=

# GHL Location ID for RG's sub-account
# Settings -> Business Profile -> Location ID
GHL_LOCATION_ID=

# Set on Vercel; used to authenticate calls to /api/cron/sync so it's not a
# publicly triggerable endpoint. Generate any random string.
CRON_SECRET=

# Generate any random string; set the same value as a `?secret=` query param
# on the webhook URL configured in a GHL Workflow's webhook action, once the
# Phase 1 spike (see build plan) confirms webhooks work on RG's account.
GHL_WEBHOOK_SECRET=

# AI layer (spec section 6). Defaults to placeholder output — no model is
# called and nothing is billed. Set BOTH of these to enable real analysis.
# Note: seller-conversation analysis also needs GHL conversations synced,
# which this app does not do yet.
AI_PROVIDER=placeholder
OPENAI_API_KEY=
# Optional; confirm the model is one your account can use.
OPENAI_MODEL=
